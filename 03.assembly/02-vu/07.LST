     1                                  ; (bubble sort) using nested loop and swapping 2 numbers
     2                                  [org 0x0100]
     3                                  
     4                                  ; this in unconditional jump (should not be used except in this case)
     5 00000000 E90800                  jmp start
     6                                  
     7 00000003 0600040005000200        data: dw 6, 4, 5, 2     ; try changing numbers and adjusting code
     8                                  
     9                                  start:
    10 0000000B B90400                      mov cx, 4
    11                                  
    12                                      outerloop:
    13 0000000E BB0000                          mov bx, 0
    14                                  
    15                                          innerloop:
    16 00000011 8B87[0300]                          mov ax, [data + bx]
    17 00000015 3B87[0500]                          cmp ax, [data + bx + 2]
    18 00000019 760C                                jbe noswap
    19 0000001B 8B97[0500]                              mov dx, [data + bx + 2]
    20 0000001F 8997[0300]                              mov [data + bx], dx
    21 00000023 8987[0500]                              mov [data + bx + 2], ax
    22                                  
    23                                  
    24                                              noswap:
    25                                              ; check innerloop termination
    26 00000027 81C30200                            add bx, 2
    27 0000002B 81FB0600                            cmp bx, 6
    28 0000002F 75E0                                jne innerloop
    29                                  
    30                                  
    31                                  
    32                                      ; check outerloop termination
    33 00000031 81E90100                    sub cx, 1
    34 00000035 75D7                        jnz outerloop  
    35                                  
    36                                  ; exit system call
    37 00000037 B8004C                  mov ax, 0x4c00
    38 0000003A CD21                    int 0x21
